# URL pública do site (usada no sitemap, nas tags canônicas e como origem aceita pelo /api/contact)
SITE_URL=

# Até o lançamento fica false: as páginas saem com noindex. No lançamento, true.
SITE_INDEXABLE=false

# Envio do formulário de diagnóstico pela Microsoft Graph (sendMail do Microsoft 365).
# App registrado no Entra ID com permissão de aplicação Mail.Send e consentimento de administrador.
# Sem estas três, o /api/contact responde 503 e não tenta enviar.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Caixa que envia e caixa(s) que recebem (separadas por vírgula). Padrão: contato@aurionai.com.br
CONTACT_MAIL_FROM=
CONTACT_MAIL_TO=

# Origens extras aceitas pelo /api/contact, separadas por vírgula (ex.: https://www.aurionai.com.br)
CONTACT_ALLOWED_ORIGINS=
