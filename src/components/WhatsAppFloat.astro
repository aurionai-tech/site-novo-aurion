---
import { site } from '../data/site';

const href = `https://wa.me/${site.whatsapp}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar no WhatsApp"
  class="whatsapp-float"
>
  <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" fill="currentColor">
    <path
      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
    ></path>
  </svg>
</a>

<style>
  .whatsapp-float {
    position: fixed;
    right: max(1rem, var(--safe-right));
    /* Acima do dock no celular; no desktop o dock é central e o botão pode descer. */
    bottom: calc(var(--dock-clearance) + 0.5rem);
    z-index: 50;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    min-width: 44px;
    min-height: 44px;
    border-radius: 0.75rem;
    border: 1px solid var(--color-line);
    background: rgb(20 20 20 / 0.9);
    color: var(--color-gold);
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.6);
    backdrop-filter: blur(12px);
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 0.25s ease,
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }

  .whatsapp-float:hover {
    transform: translateY(-2px);
    border-color: rgb(198 178 114 / 0.45);
    background: var(--color-gold);
    color: var(--color-bg);
  }

  .whatsapp-float:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
  }

  @media (width >= 40rem) {
    .whatsapp-float {
      right: max(1.5rem, var(--safe-right));
      bottom: calc(1.5rem + var(--safe-bottom));
    }
  }

  /* Celular deitado: alinha com o dock e deixa margem do notch. */
  @media (max-width: 63.99rem) and (max-height: 500px) and (orientation: landscape) {
    .whatsapp-float {
      right: max(0.65rem, var(--safe-right));
      bottom: calc(0.65rem + var(--safe-bottom));
      width: 2.75rem;
      height: 2.75rem;
    }

    .whatsapp-float :global(svg) {
      width: 1.25rem;
      height: 1.25rem;
    }
  }
</style>
