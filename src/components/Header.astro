---
import Logo from './Logo.astro';
import { nav } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-bg/85 backdrop-blur">
  <div class="container-site flex h-18 items-center justify-between gap-6">
    <a href="/" class="text-fg" aria-label="Aurion — página inicial">
      <Logo class="h-5 w-auto md:h-6" />
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Principal">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-xs font-medium tracking-[0.12em] uppercase transition hover:text-gold',
              isActive(item.href) ? 'text-gold' : 'text-muted',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href="/contato" class="btn-primary hidden lg:inline-flex">Agendar diagnóstico</a>

    <details class="relative lg:hidden">
      <summary class="cursor-pointer list-none rounded-md border border-line px-3 py-1.5 text-xs font-semibold tracking-[0.12em] uppercase">
        Menu
      </summary>
      <div class="absolute right-0 mt-2 w-60 rounded-xl border border-line bg-surface p-2 shadow-2xl">
        {
          nav.map((item) => (
            <a href={item.href} class="block rounded-lg px-3 py-2 text-sm hover:bg-surface-2 hover:text-gold">
              {item.label}
            </a>
          ))
        }
        <a href="/contato" class="btn-primary mt-2 w-full">Agendar diagnóstico</a>
      </div>
    </details>
  </div>
</header>
