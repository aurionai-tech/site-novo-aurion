---
import { nav, site } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 border-b border-line bg-white/90 backdrop-blur">
  <div class="container-site flex h-16 items-center justify-between gap-6">
    <a href="/" class="text-lg font-bold tracking-tight">{site.nome}</a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Principal">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-sm transition hover:text-ink',
              isActive(item.href) ? 'font-semibold text-ink' : 'text-muted',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href="/contato" class="btn-primary hidden md:inline-flex">Agendar diagnóstico</a>

    <details class="group relative md:hidden">
      <summary class="cursor-pointer list-none rounded-md border border-line px-3 py-1.5 text-sm font-medium">
        Menu
      </summary>
      <div class="absolute right-0 mt-2 w-56 rounded-xl border border-line bg-white p-2 shadow-lg">
        {
          nav.map((item) => (
            <a href={item.href} class="block rounded-lg px-3 py-2 text-sm hover:bg-surface">
              {item.label}
            </a>
          ))
        }
        <a href="/contato" class="mt-1 block rounded-lg bg-accent px-3 py-2 text-sm font-semibold text-white">
          Agendar diagnóstico
        </a>
      </div>
    </details>
  </div>
</header>
