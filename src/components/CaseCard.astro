---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'cases'>;
}

const { entry } = Astro.props;
const { titulo, cliente, segmento, resumo, autorizado } = entry.data;
---

<a href={`/cases/${entry.id}`} class="card group flex flex-col hover:border-gold/50">
  <p class="eyebrow">{segmento}</p>
  <h3 class="mt-3 text-lg font-semibold group-hover:text-gold">{titulo}</h3>
  <p class="mt-1 text-sm text-sand">{cliente}</p>
  <p class="mt-4 flex-1 text-sm leading-relaxed text-muted">{resumo}</p>
  {!autorizado && <span class="rascunho mt-5 w-fit">aguardando autorização do cliente</span>}
</a>
