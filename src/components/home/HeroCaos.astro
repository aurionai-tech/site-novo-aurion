---
import { Image } from 'astro:assets';
import simboloBrilho from '../../assets/brand/simbolo-brilho.png';
import { site } from '../../data/site';

const fases = [
  { titulo: 'Como costuma ser', texto: 'Cada pessoa faz do seu jeito, entre planilhas, mensagens e exceções.' },
  { titulo: 'Base organizada', texto: 'Um fluxo claro, com etapas e responsáveis que todo mundo segue.' },
  { titulo: 'Tecnologia aplicada', texto: 'Com tudo no lugar, software, dados e IA passam a gerar valor.' },
];
---

<section data-hero-caos class="hero-caos relative">
  <div class="sticky top-0 h-svh overflow-hidden">
    <Image
      src={simboloBrilho}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="100vw"
      loading="eager"
      class="hero-fallback pointer-events-none absolute inset-0 h-full w-full object-cover object-right opacity-70"
    />
    <canvas data-hero-canvas class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
    <div
      class="pointer-events-none absolute inset-0 bg-linear-to-t from-bg via-bg/70 to-transparent lg:bg-linear-to-r lg:from-bg lg:via-bg/50 lg:to-transparent"
    >
    </div>

    <div class="hero-copy relative container-site flex h-full flex-col justify-end lg:justify-center lg:pb-0">
      <p data-hero-texto class="eyebrow fade-up" style="--d:0.2s">{site.assinatura}</p>
      <h1 class="hero-title mt-4 font-light tracking-tight sm:mt-6">
        <span class="line-reveal"><span style="--d:0.3s">Primeiro o processo.</span></span>
        <span class="line-reveal">
          <span style="--d:0.45s" class="font-semibold text-gold">Depois a tecnologia.</span>
        </span>
      </h1>
      <p class="hero-lead fade-up mt-5 max-w-md leading-relaxed text-muted sm:mt-8 md:text-lg" style="--d:0.8s">
        A Aurion começa entendendo como a sua operação funciona no dia a dia. Só depois partimos para software, dados e
        automação.
      </p>
      <div class="fade-up mt-7 flex flex-wrap gap-3 sm:mt-10 sm:gap-4" style="--d:1s">
        <a href="/contato" class="btn-primary">Agendar diagnóstico</a>
        <a href="/como-trabalhamos" class="btn-secondary hidden sm:inline-flex">Como trabalhamos</a>
      </div>
    </div>

    <div class="hero-fases fade-up pointer-events-none absolute inset-x-0" style="--d:1.2s">
      <div class="container-site">
        <div data-hero-fases class="lg:ml-auto lg:max-w-176">
          <div class="relative h-px bg-line">
            <span data-fase-barra class="absolute inset-0 origin-left bg-gold" style="scale: 0 1"></span>
          </div>
          <ol class="mt-4 grid lg:grid-cols-3 lg:gap-8">
            {
              fases.map((f, i) => (
                <li data-fase data-active={i === 0 ? '' : undefined} class="fase">
                  <p class="text-[11px] font-medium tracking-[0.25em] uppercase">
                    <span class="mr-2 text-gold">0{i + 1}</span>
                    {f.titulo}
                  </p>
                  <p class="mt-2 hidden text-sm leading-relaxed text-muted lg:block">{f.texto}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>

    <div data-scroll-cue class="pointer-events-none absolute inset-x-0 bottom-10 hidden lg:block">
      <div class="container-site flex items-center gap-4 text-[11px] tracking-[0.25em] text-muted uppercase">
        <span class="scroll-cue-line" aria-hidden="true"></span>
        Role para organizar
      </div>
    </div>
  </div>
</section>

<style>
  .hero-caos {
    height: 100svh;
  }

  .hero-caos > .sticky {
    height: 100svh;
    height: 100dvh;
  }

  .hero-copy {
    /* Reserva dock + botão do WhatsApp no canto, para o CTA não ficar por baixo. */
    padding-bottom: calc(var(--dock-clearance) + 4.25rem);
  }

  .hero-title {
    font-size: clamp(1.85rem, 7.5vw, 4.2rem);
    line-height: 1.05;
  }

  .hero-fases {
    top: max(1.25rem, var(--safe-top));
  }

  @media (width >= 40rem) {
    .hero-copy {
      padding-bottom: var(--dock-clearance);
    }
  }

  @media (width >= 64rem) {
    .hero-copy {
      padding-bottom: 0;
    }

    .hero-fases {
      top: 2.5rem;
    }
  }

  /* Telas baixas (SE, landscape): compacta tipografia e espaços para caber na viewport. */
  @media (max-width: 63.99rem) and (max-height: 720px) {
    .hero-title {
      font-size: clamp(1.55rem, 6.2vw, 2.2rem);
    }

    .hero-lead {
      margin-top: 0.75rem;
      font-size: 0.9rem;
      line-height: 1.45;
    }

    .hero-copy .mt-7 {
      margin-top: 0.85rem;
    }

    .hero-fases .mt-4 {
      margin-top: 0.5rem;
    }
  }

  /*
   * Celular deitado: composição em duas colunas para aproveitar a largura
   * e liberar altura — copy à esquerda, fases compactas à direita.
   */
  @media (max-width: 63.99rem) and (max-height: 500px) and (orientation: landscape) {
    .hero-lead {
      display: none;
    }

    .hero-copy {
      justify-content: center;
      width: min(34rem, 54%);
      max-width: min(34rem, 54%);
      margin-left: 0;
      margin-right: auto;
      padding-top: max(0.75rem, var(--safe-top));
      padding-bottom: calc(var(--dock-clearance) + 0.35rem);
      padding-left: max(1rem, var(--safe-left));
      padding-right: 0.75rem;
    }

    .hero-copy .eyebrow {
      margin-bottom: 0;
    }

    .hero-title {
      margin-top: 0.45rem;
      font-size: clamp(1.3rem, 4.2vw, 1.85rem);
    }

    .hero-copy .mt-7 {
      margin-top: 0.7rem;
    }

    .hero-copy .btn-primary {
      min-height: 2.5rem;
      padding-block: 0.55rem;
      padding-inline: 1rem;
    }

    .hero-copy .btn-secondary {
      display: none;
    }

    .hero-fases {
      inset: auto;
      top: 50%;
      right: max(1rem, var(--safe-right));
      width: min(15.5rem, 34%);
      transform: translateY(calc(-50% - 1.5rem));
      padding-inline: 0;
    }

    .hero-fases .container-site {
      width: 100%;
      max-width: none;
      padding-inline: 0;
    }

    .hero-fases [data-hero-fases] {
      margin-left: 0;
      max-width: none;
    }

    .hero-fases .h-px {
      display: none;
    }

    .hero-fases ol {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      margin-top: 0;
    }

    .fase p:first-child {
      font-size: 10px;
      letter-spacing: 0.18em;
    }

    .fase p + p {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero-caos {
      height: 300vh;
    }

    /* No celular a seção é um pouco mais curta que no desktop, mas ainda dá tempo da constelação. */
    @media (max-width: 63.99rem) {
      :global(html.js) .hero-caos {
        height: 260vh;
      }
    }

    @media (max-width: 63.99rem) and (max-height: 500px) and (orientation: landscape) {
      :global(html.js) .hero-caos {
        height: 220vh;
      }
    }
  }

  :global(html.js) .hero-fallback {
    display: none;
  }

  .fase {
    opacity: 0.35;
    transition: opacity 0.5s ease;
  }

  .fase[data-active] {
    opacity: 1;
  }

  @media (width < 64rem) {
    .fase:not([data-active]) {
      display: none;
    }
  }

  /* Em landscape as três fases voltam a aparecer, em coluna à direita. */
  @media (max-width: 63.99rem) and (max-height: 500px) and (orientation: landscape) {
    .fase:not([data-active]) {
      display: block;
    }
  }

  .scroll-cue-line {
    position: relative;
    width: 3rem;
    height: 1px;
    overflow: hidden;
    background: var(--color-line);
  }

  .scroll-cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-gold);
    animation: cue 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes cue {
    from {
      translate: -100% 0;
    }
    to {
      translate: 100% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue-line::after {
      animation: none;
    }
  }
</style>

<script>
  import { initHeroCaos } from '../../scripts/hero-caos';
  import { criarCenaConstelacao } from '../../scripts/hero-constelacao';

  const section = document.querySelector<HTMLElement>('[data-hero-caos]');
  if (section) initHeroCaos(section, criarCenaConstelacao);
</script>
