---
import { metodo } from '../data/site';

interface Props {
  detailed?: boolean;
}

const { detailed = false } = Astro.props;
---

<ol class:list={['grid gap-px overflow-hidden rounded-xl border border-line bg-line', detailed ? 'md:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3']}>
  {
    metodo.map((etapa, i) => (
      <li class="bg-surface p-8 transition hover:bg-surface-2">
        <span class="text-sm font-light text-gold">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-3 text-lg font-semibold">{etapa.titulo}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{etapa.descricao}</p>
        {detailed && (
          <p class="mt-5 border-t border-line pt-5 text-sm">
            <span class="font-semibold text-gold">Você recebe:</span> <span class="text-sand">{etapa.entrega}</span>
          </p>
        )}
      </li>
    ))
  }
</ol>
