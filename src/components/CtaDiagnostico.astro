---
interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Vamos começar pelo processo?',
  text = 'Conte como a sua operação funciona hoje. A primeira conversa serve para entender o seu cenário antes de qualquer proposta.',
} = Astro.props;
---

<section class="relative overflow-hidden border-t border-line">
  <div
    class="pointer-events-none absolute top-1/2 left-1/2 h-112 w-112 -translate-x-1/2 -translate-y-1/2 rounded-full bg-gold/10 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div data-build class="relative container-site flex max-w-3xl flex-col items-center py-28 text-center md:py-36">
    <p class="eyebrow">Próximo passo</p>
    <h2 class="mt-6 text-4xl leading-tight font-light tracking-tight md:text-6xl">{title}</h2>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{text}</p>
    <a href="/contato" class="btn-primary mt-12">Agendar diagnóstico</a>
  </div>
</section>
