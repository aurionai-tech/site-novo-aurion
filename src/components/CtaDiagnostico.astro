---
interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Vamos começar pelo processo?',
  text = 'Conte como a sua operação funciona hoje. A primeira conversa é um diagnóstico — não uma proposta pronta.',
} = Astro.props;
---

<section class="bg-ink text-white">
  <div class="container-site flex flex-col items-start gap-6 py-16 md:flex-row md:items-center md:justify-between">
    <div class="max-w-xl">
      <h2 class="text-3xl font-bold tracking-tight">{title}</h2>
      <p class="mt-3 text-white/70">{text}</p>
    </div>
    <a href="/contato" class="btn-primary shrink-0 hover:bg-white hover:text-ink">Agendar diagnóstico</a>
  </div>
</section>
