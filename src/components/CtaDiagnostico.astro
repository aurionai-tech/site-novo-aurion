---
interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Vamos começar pelo processo?',
  text = 'Conte como a sua operação funciona hoje. A primeira conversa é um diagnóstico — não uma proposta pronta.',
} = Astro.props;
---

<section class="relative overflow-hidden border-t border-line bg-surface">
  <div
    class="pointer-events-none absolute -top-40 right-0 h-96 w-96 rounded-full bg-gold/15 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div class="relative container-site flex flex-col items-start gap-8 py-20 md:flex-row md:items-center md:justify-between">
    <div class="max-w-xl">
      <h2 class="text-3xl font-light tracking-tight md:text-4xl">{title}</h2>
      <p class="mt-4 leading-relaxed text-muted">{text}</p>
    </div>
    <a href="/contato" class="btn-primary shrink-0">Agendar diagnóstico</a>
  </div>
</section>
