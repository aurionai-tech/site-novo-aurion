---
import { nav, site } from '../data/site';

const ano = new Date().getFullYear();
---

<footer class="border-t border-line bg-bg">
  <div class="container-site grid gap-12 py-16 text-center md:grid-cols-[1.4fr_1fr_1fr] md:text-left">
    <div class="flex justify-center md:justify-start">
      <img src="/brand/logo-dourado-branco-recortado.svg" alt="Aurion" width="192" height="99" class="h-auto w-48" />
    </div>

    <nav aria-label="Rodapé" class="grid content-start justify-items-center gap-3 text-sm md:justify-items-start">
      <p class="eyebrow mb-1">Navegação</p>
      {nav.map((item) => <a href={item.href} class="text-muted hover:text-gold">{item.label}</a>)}
      <a href="/seguranca" class="text-muted hover:text-gold">Segurança e LGPD</a>
      <a href="/privacidade" class="text-muted hover:text-gold">Política de privacidade</a>
      <button type="button" data-cookie-open class="cursor-pointer text-muted hover:text-gold">
        Cookies
      </button>
    </nav>

    <div class="grid content-start justify-items-center gap-3 text-sm md:justify-items-start">
      <p class="eyebrow mb-1">Contato</p>
      <a href={`mailto:${site.email}`} class="text-muted hover:text-gold">{site.email}</a>
      <a href={`https://wa.me/${site.whatsapp}`} class="text-muted hover:text-gold">WhatsApp</a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-gold">LinkedIn</a>
      <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-gold">Instagram</a>
    </div>
  </div>

  <div class="border-t border-line">
    <div
      class="container-site flex flex-col items-center gap-2 pt-6 text-center text-xs text-muted md:flex-row md:items-start md:justify-between md:text-left"
      style="padding-bottom: calc(var(--dock-clearance) + 1rem)"
    >
      <p>© {ano} {site.nome}. Todos os direitos reservados.</p>
      <p class="tracking-[0.3em] uppercase">{site.assinatura}</p>
    </div>
  </div>
</footer>
