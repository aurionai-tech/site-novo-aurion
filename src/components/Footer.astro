---
import { nav, site } from '../data/site';

const ano = new Date().getFullYear();
---

<footer class="border-t border-line bg-bg">
  <div class="container-site grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <img src="/brand/logo-dourado-branco-recortado.svg" alt="Aurion" width="192" height="99" class="h-auto w-48" />
    </div>

    <nav aria-label="Rodapé" class="grid content-start gap-3 text-sm">
      <p class="eyebrow mb-1">Navegação</p>
      {nav.map((item) => <a href={item.href} class="text-muted hover:text-gold">{item.label}</a>)}
      <a href="/seguranca" class="text-muted hover:text-gold">Segurança e LGPD</a>
      <a href="/privacidade" class="text-muted hover:text-gold">Política de privacidade</a>
    </nav>

    <div class="grid content-start gap-3 text-sm">
      <p class="eyebrow mb-1">Contato</p>
      {site.email ? <a href={`mailto:${site.email}`} class="text-muted hover:text-gold">{site.email}</a> : <span class="rascunho w-fit">e-mail a definir</span>}
      {site.whatsapp ? <a href={`https://wa.me/${site.whatsapp}`} class="text-muted hover:text-gold">WhatsApp</a> : <span class="rascunho w-fit">WhatsApp a definir</span>}
      {site.linkedin && <a href={site.linkedin} class="text-muted hover:text-gold">LinkedIn</a>}
    </div>
  </div>

  <div class="border-t border-line">
    <div class="container-site flex flex-col gap-2 pt-6 pb-28 text-xs text-muted md:flex-row md:justify-between">
      <p>© {ano} {site.nome}. Todos os direitos reservados.</p>
      <p class="tracking-[0.3em] uppercase">{site.assinatura}</p>
    </div>
  </div>
</footer>
