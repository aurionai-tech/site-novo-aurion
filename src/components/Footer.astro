---
import { nav, site } from '../data/site';

const ano = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface">
  <div class="container-site grid gap-10 py-12 md:grid-cols-3">
    <div>
      <p class="text-lg font-bold">{site.nome}</p>
      <p class="mt-2 max-w-xs text-sm text-muted">Primeiro o processo. Depois a tecnologia.</p>
    </div>

    <nav aria-label="Rodapé" class="grid gap-2 text-sm">
      {nav.map((item) => <a href={item.href} class="text-muted hover:text-ink">{item.label}</a>)}
      <a href="/seguranca" class="text-muted hover:text-ink">Segurança e LGPD</a>
      <a href="/privacidade" class="text-muted hover:text-ink">Política de privacidade</a>
    </nav>

    <div class="grid content-start gap-2 text-sm">
      <p class="font-semibold">Contato</p>
      {site.email ? <a href={`mailto:${site.email}`} class="text-muted hover:text-ink">{site.email}</a> : <span class="rascunho w-fit">e-mail a definir</span>}
      {site.whatsapp ? <a href={`https://wa.me/${site.whatsapp}`} class="text-muted hover:text-ink">WhatsApp</a> : <span class="rascunho w-fit">WhatsApp a definir</span>}
      {site.linkedin && <a href={site.linkedin} class="text-muted hover:text-ink">LinkedIn</a>}
    </div>
  </div>

  <div class="border-t border-line">
    <p class="container-site py-5 text-xs text-muted">© {ano} {site.nome}. Todos os direitos reservados.</p>
  </div>
</footer>
