---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaDiagnostico from '../components/CtaDiagnostico.astro';
import barrasOuro from '../assets/brand/barras-ouro.png';
import { comoOperamos, conceitoMarca, equipe, ecossistema, principio, site } from '../data/site';
---

<Layout
  title="Sobre"
  description="A Aurion é um hub de tecnologia e software house multidisciplinar. Conheça nossos valores, equipe e ecossistema."
>
  <PageHero
    eyebrow="Sobre a Aurion"
    title="Um hub de tecnologia que começa pelo negócio"
    intro="Somos uma software house multidisciplinar: engenharia de software, inteligência de dados e transformação digital, sempre sobre processos reais."
  />

  <section>
    <div class="container-site py-24">
      <span class="rascunho">história da Aurion a escrever</span>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
        [Rascunho] Como e por que a Aurion surgiu, e o que nos move.
      </p>
    </div>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="container-site grid gap-14 py-24 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHeading eyebrow="A marca" title={site.assinatura} />
        <ul class="mt-8 grid gap-5">
          {conceitoMarca.simbolo.map((t) => <li class="border-l-2 border-gold pl-5 leading-relaxed text-muted">{t}</li>)}
        </ul>
        <ul class="mt-10 flex flex-wrap gap-2">
          {
            conceitoMarca.palavras.map((p) => (
              <li class="rounded-md border border-line px-3 py-1.5 text-xs tracking-[0.15em] text-sand uppercase">{p}</li>
            ))
          }
        </ul>
      </div>
      <Image
        src={barrasOuro}
        alt="Símbolo da Aurion representado por uma barra de concreto e uma barra de ouro inclinada"
        widths={[600, 1000]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="w-full rounded-xl border border-line"
      />
    </div>
  </section>

  <section class="border-t border-line">
    <div class="container-site py-24">
      <SectionHeading eyebrow="Valores" title={principio.frase} intro={principio.explicacao} />
      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          comoOperamos.map((v) => (
            <article class="card">
              <h3 class="font-semibold">{v.titulo}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{v.descricao}</p>
            </article>
          ))
        }
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {
          conceitoMarca.cores.map((c) => (
            <div class="flex items-center gap-4 rounded-xl border border-line p-5">
              <span class="size-10 shrink-0 rounded-md border border-line" style={`background:${c.hex}`} />
              <p class="text-sm text-muted">
                <span class="font-semibold text-fg">{c.nome}.</span> {c.significado}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="container-site py-24">
      <SectionHeading
        eyebrow="Equipe"
        title="Papéis claros, responsabilidade compartilhada"
        intro="Uma equipe multidisciplinar que opera de forma horizontal."
      />
      <span class="rascunho mt-6 inline-block">confirmar com cada pessoa antes de publicar nomes e fotos</span>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          equipe.map((p) => (
            <li class="card bg-bg">
              <div class="mb-5 grid size-14 place-items-center rounded-full border border-gold/40 text-lg font-light text-gold" aria-hidden="true">
                {p.nome.charAt(0)}
              </div>
              <p class="font-semibold">{p.nome}</p>
              <p class="mt-1 text-sm text-muted">{p.papel}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="container-site py-24">
      <SectionHeading eyebrow="Ecossistema" title="Conectados à inovação regional" />
      <ul class="mt-12 grid gap-6 md:grid-cols-3">
        {
          ecossistema.map((e) => (
            <li class="card">
              <p class="text-lg font-semibold">{e.nome}</p>
              <p class="mt-2 text-sm text-muted">{e.detalhe}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaDiagnostico />
</Layout>
