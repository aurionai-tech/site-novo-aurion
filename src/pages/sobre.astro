---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaDiagnostico from '../components/CtaDiagnostico.astro';
import barrasOuro from '../assets/brand/barras-ouro.png';
import { comoOperamos, competencias, conceitoMarca, historia, principio, site } from '../data/site';
---

<Layout
  title="Sobre"
  description="A Aurion é um hub de tecnologia e software house multidisciplinar. Conheça nossos valores e áreas de competência."
>
  <PageHero
    eyebrow="Sobre a Aurion"
    title="Um hub de tecnologia que começa pelo negócio"
    intro="Somos uma software house que trabalha com engenharia de software, inteligência de dados e transformação digital, sempre partindo de como cada cliente trabalha."
  />

  <section>
    <div class="container-site grid gap-14 py-24 lg:grid-cols-[1.4fr_1fr] lg:gap-20">
      <div>
        <p class="eyebrow">Nossa história</p>
        <div class="mt-8 grid gap-6 text-lg leading-relaxed text-muted">
          {historia.paragrafos.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <blockquote class="self-end border-l-2 border-gold pl-8">
        {
          historia.fecho.map((linha, i) => (
            <p
              data-build
              style={`--d:${i * 120}ms`}
              class:list={[
                'text-2xl leading-snug font-light tracking-tight md:text-3xl',
                i === historia.fecho.length - 1 && 'font-medium text-gold',
              ]}
            >
              {linha}
            </p>
          ))
        }
      </blockquote>
    </div>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="container-site grid gap-14 py-24 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHeading eyebrow="A marca" title={site.assinatura} />
        <ul class="mt-8 grid gap-5">
          {conceitoMarca.simbolo.map((t) => <li class="border-l-2 border-gold pl-5 leading-relaxed text-muted">{t}</li>)}
        </ul>
        <ul class="mt-10 flex flex-wrap gap-2">
          {
            conceitoMarca.palavras.map((p) => (
              <li class="cursor-default rounded-md border border-line px-3 py-1.5 text-xs tracking-[0.15em] text-sand uppercase transition hover:-translate-y-0.5 hover:border-gold hover:text-gold">
                {p}
              </li>
            ))
          }
        </ul>
      </div>
      <Image
        src={barrasOuro}
        alt="Símbolo da Aurion representado por uma barra de concreto e uma barra de ouro inclinada"
        widths={[600, 1000]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="w-full rounded-xl border border-line"
      />
    </div>
  </section>

  <section class="border-t border-line">
    <div class="container-site py-24">
      <SectionHeading eyebrow="Valores" title={principio.frase} intro={principio.explicacao} />
      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          comoOperamos.map((v, i) => (
            <article data-build style={`--d:${i * 80}ms`} class="card">
              <h3 class="font-semibold">{v.titulo}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{v.descricao}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="container-site py-24">
      <SectionHeading
        eyebrow="Competências"
        title="Da análise à infraestrutura"
        intro="Cuidamos de tudo o que um projeto precisa, do diagnóstico à operação."
      />
      <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          competencias.map((c, i) => (
            <li data-build style={`--d:${i * 60}ms`} class="card bg-bg">
              <p class="font-semibold">{c.titulo}</p>
              <p class="mt-2 text-sm leading-relaxed text-muted">{c.descricao}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaDiagnostico />
</Layout>
