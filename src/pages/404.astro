---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página não encontrada">
  <section class="container-site py-36 text-center">
    <p class="eyebrow">Erro 404</p>
    <h1 class="mt-5 text-4xl font-light tracking-tight">Esta página não existe</h1>
    <p class="mt-5 text-muted">O endereço pode ter mudado ou sido digitado errado.</p>
    <a href="/" class="btn-primary mt-12">Voltar para o início</a>
  </section>
</Layout>
