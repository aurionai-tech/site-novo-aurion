---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página não encontrada">
  <section class="container-site py-32 text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-accent">Erro 404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight">Esta página não existe</h1>
    <p class="mt-4 text-muted">O endereço pode ter mudado ou sido digitado errado.</p>
    <a href="/" class="btn-primary mt-10">Voltar para o início</a>
  </section>
</Layout>
