---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaDiagnostico from '../components/CtaDiagnostico.astro';
import { servicos, submarcas } from '../data/site';
---

<Layout
  title="Serviços"
  description="Análise de negócio, engenharia de software, inteligência de dados, IA e automação, infraestrutura e TI."
>
  <PageHero
    eyebrow="Serviços"
    title="Tecnologia como consequência de uma operação organizada"
    intro="Vendemos análise de negócio e engenharia — não atalho sem diagnóstico. Todo projeto começa pelo entendimento do processo."
  />

  <section>
    <div class="container-site grid gap-6 py-24">
      {
        servicos.map((s, i) => (
          <article class="card grid gap-6 p-8 hover:border-gold/50 md:grid-cols-[auto_1fr_1fr] md:gap-12">
            <span class="text-2xl font-light text-gold">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h2 class="text-2xl font-light tracking-tight">{s.titulo}</h2>
              <p class="mt-3 leading-relaxed text-muted">{s.descricao}</p>
            </div>
            <ul class="grid content-start gap-2 text-sm text-sand">
              {s.itens.map((item) => (
                <li class="flex gap-3">
                  <span class="text-gold">—</span>
                  {item}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="container-site py-24">
      <SectionHeading eyebrow="Frentes Aurion" title="Frentes especializadas" />
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {
          submarcas.map((m) => (
            <article class="card flex flex-col items-center bg-bg text-center">
              <img src={m.logo} alt={m.nome} width="192" height="99" class="h-auto w-44" loading="lazy" />
              {m.emBreve ? (
                <p class="mt-6 text-xs tracking-[0.2em] text-muted uppercase">Em breve</p>
              ) : (
                <p class="mt-6 text-sm leading-relaxed text-muted">{m.descricao}</p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaDiagnostico />
</Layout>
