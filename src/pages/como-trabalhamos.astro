---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MethodSteps from '../components/MethodSteps.astro';
import CtaDiagnostico from '../components/CtaDiagnostico.astro';
import { diagnostico, principio } from '../data/site';

const situacoes = [
  {
    situacao: 'O pedido é “automatizar” algo que hoje é caótico',
    resposta: 'Paramos e mapeamos o processo antes de propor qualquer solução.',
  },
  {
    situacao: 'Cada pessoa faz do seu jeito, sem fluxo definido',
    resposta: 'Organizamos o fluxo com a sua equipe. A automação vem depois.',
  },
  {
    situacao: 'O processo está mapeado e validado',
    resposta: 'Nesse ponto entram IA, integrações, agentes e pipelines de dados.',
  },
];
---

<Layout
  title="Como trabalhamos"
  description="O método da Aurion: diagnóstico, mapeamento e fluxo acordado antes de software, dados e automação."
>
  <PageHero eyebrow="Como trabalhamos" title={principio.frase} intro={principio.explicacao} />

  <section>
    <div class="container-site py-24">
      <SectionHeading
        title="Seis etapas, sempre na mesma ordem"
        intro="Ao fim de cada etapa, você recebe uma entrega concreta e sabe o que foi feito."
      />
      <div class="mt-14">
        <MethodSteps detailed />
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="container-site py-24">
      <SectionHeading
        eyebrow="A primeira etapa"
        title="Como é o diagnóstico"
        intro="É um projeto de imersão, feito em encontros com a sua equipe, que termina em um plano de ação. Prazo, frequência e número de encontros são combinados com cada empresa."
      />

      <ol class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          diagnostico.etapas.map((etapa, i) => (
            <li data-build style={`--d:${i * 80}ms`} class="card flex flex-col bg-bg">
              <span class="text-4xl font-light tracking-tight text-gold">{String(i + 1).padStart(2, '0')}</span>
              <p class="mt-5 text-[11px] font-medium tracking-[0.2em] text-muted uppercase">{etapa.conduz}</p>
              <h3 class="mt-2 text-xl font-semibold">{etapa.titulo}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{etapa.descricao}</p>
              <ul class="mt-auto flex flex-wrap gap-2 pt-6">
                {etapa.temas.map((tema) => (
                  <li class="rounded-full border border-line px-3 py-1 text-xs text-sand">{tema}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>

      <div class="mt-6 grid gap-6 lg:grid-cols-2">
        <div data-build class="card bg-bg">
          <p class="eyebrow">O que você recebe</p>
          <ul class="mt-6 grid gap-3">
            {
              diagnostico.entregaveis.map((item) => (
                <li class="flex gap-3 leading-relaxed text-sand">
                  <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div data-build style="--d:80ms" class="card bg-bg">
          <p class="eyebrow">O que a sua equipe prepara</p>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {
              diagnostico.preparo.map((item) => (
                <li class="flex gap-3 text-sm leading-relaxed text-muted">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full border border-gold" aria-hidden="true" />
                  {item}
                </li>
              ))
            }
          </ul>
          <p class="mt-6 border-t border-line pt-5 text-sm leading-relaxed text-sand">{diagnostico.presenca}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="container-site py-24">
      <SectionHeading
        title="Quando dizemos “ainda não”"
        intro="Automatizar um processo desorganizado só acelera o problema. Por isso, às vezes o primeiro passo é organizar."
      />
      <div class="mt-14 overflow-hidden rounded-xl border border-line bg-bg">
        {
          situacoes.map((s, i) => (
            <details name="situacoes" open={i === 0} class:list={['accordion group', i > 0 && 'border-t border-line']}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-8 py-6 font-semibold transition hover:text-gold [&::-webkit-details-marker]:hidden">
                {s.situacao}
                <span
                  class="grid size-8 shrink-0 place-items-center rounded-full border border-line text-gold transition duration-300 group-open:rotate-45 group-open:border-gold"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="px-8 pb-6 text-muted">
                <span class="mr-2 text-gold">→</span>
                {s.resposta}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaDiagnostico />
</Layout>
