---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CtaDiagnostico from '../../components/CtaDiagnostico.astro';
import { getPublishedCases } from '../../lib/cases';

export async function getStaticPaths() {
  const cases = await getPublishedCases();
  return cases.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { titulo, cliente, segmento, resumo, problema, processo, solucao, resultado, autorizado } = entry.data;
const { Content } = await render(entry);

const blocos = [
  { titulo: 'O problema', texto: problema },
  { titulo: 'O processo que mapeamos', texto: processo },
  { titulo: 'A solução', texto: solucao },
  { titulo: 'O resultado', texto: resultado },
];
---

<Layout title={titulo} description={resumo}>
  <section class="border-b border-line">
    <div class="container-site py-20 md:py-28">
      <a href="/cases" class="text-xs font-semibold tracking-[0.15em] text-muted uppercase hover:text-gold">← Todos os cases</a>
      <p class="eyebrow mt-8">{segmento} · {cliente}</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-light tracking-tight md:text-5xl">{titulo}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{resumo}</p>
      {!autorizado && <span class="rascunho mt-8 inline-block">aguardando autorização do cliente — não aparece em produção</span>}
    </div>
  </section>

  <section>
    <div class="container-site grid gap-px overflow-hidden py-24 md:grid-cols-2">
      {
        blocos.map((b, i) => (
          <div class="border-t border-line py-10 md:pr-12">
            <span class="text-2xl font-light text-gold">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="mt-3 text-2xl font-light tracking-tight">{b.titulo}</h2>
            <p class="mt-4 leading-relaxed text-muted">{b.texto}</p>
          </div>
        ))
      }
    </div>

    <div class="container-site max-w-3xl pb-24 leading-relaxed text-muted [&_p]:mt-4">
      <Content />
    </div>
  </section>

  <CtaDiagnostico />
</Layout>
