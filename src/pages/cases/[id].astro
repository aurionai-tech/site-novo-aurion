---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CtaDiagnostico from '../../components/CtaDiagnostico.astro';
import { getPublishedCases } from '../../lib/cases';

export async function getStaticPaths() {
  const cases = await getPublishedCases();
  return cases.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { titulo, cliente, segmento, resumo, problema, processo, solucao, resultado, autorizado } = entry.data;
const { Content } = await render(entry);

const blocos = [
  { titulo: 'O problema', texto: problema },
  { titulo: 'O processo que mapeamos', texto: processo },
  { titulo: 'A solução', texto: solucao },
  { titulo: 'O resultado', texto: resultado },
];
---

<Layout title={titulo} description={resumo}>
  <section class="border-b border-line bg-surface">
    <div class="container-site py-16 md:py-20">
      <a href="/cases" class="text-sm text-muted hover:text-ink">← Todos os cases</a>
      <p class="mt-6 text-sm font-semibold uppercase tracking-wider text-accent">{segmento} · {cliente}</p>
      <h1 class="mt-2 max-w-3xl text-4xl font-bold tracking-tight md:text-5xl">{titulo}</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">{resumo}</p>
      {!autorizado && <span class="rascunho mt-6 inline-block">aguardando autorização do cliente — não aparece em produção</span>}
    </div>
  </section>

  <section>
    <div class="container-site grid gap-10 py-20 md:grid-cols-2">
      {
        blocos.map((b, i) => (
          <div>
            <span class="text-sm font-semibold text-accent">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="mt-2 text-2xl font-bold tracking-tight">{b.titulo}</h2>
            <p class="mt-3 text-muted">{b.texto}</p>
          </div>
        ))
      }
    </div>

    <div class="container-site max-w-3xl pb-20 text-muted [&_p]:mt-4">
      <Content />
    </div>
  </section>

  <CtaDiagnostico />
</Layout>
