---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CaseCard from '../../components/CaseCard.astro';
import CtaDiagnostico from '../../components/CtaDiagnostico.astro';
import { getPublishedCases } from '../../lib/cases';

const cases = await getPublishedCases();
---

<Layout title="Cases" description="Projetos da Aurion contados do problema ao resultado.">
  <PageHero
    eyebrow="Cases"
    title="Do problema ao resultado"
    intro="Cada case mostra o problema, o processo que mapeamos, a solução construída e o que mudou."
  />

  <section>
    <div class="container-site py-20">
      {
        cases.length > 0 ? (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {cases.map((entry) => (
              <CaseCard entry={entry} />
            ))}
          </div>
        ) : (
          <p class="text-muted">Em breve, os primeiros cases publicados.</p>
        )
      }
    </div>
  </section>

  <CtaDiagnostico />
</Layout>
