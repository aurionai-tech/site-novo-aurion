---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';

const inputClass =
  'mt-2 w-full rounded-md border border-line bg-surface px-4 py-3 text-sm text-fg outline-none transition placeholder:text-muted/60 focus:border-gold focus:ring-2 focus:ring-gold/20';
const labelClass = 'block text-sm font-medium text-sand';

const origem = Astro.url.searchParams.get('origem');
const isLab = origem === 'aurion-lab';
const isCloud = origem === 'aurion-cloud';

const heroPorOrigem = isLab
  ? {
      title: 'Falar sobre o projeto',
      description: 'Conte como você imagina o produto. A primeira conversa com a Aurion Lab é sobre o seu projeto.',
      eyebrow: 'Aurion Lab',
      heroTitle: 'Conte como você imagina o produto',
      heroIntro: 'Não precisa estar tudo definido. Queremos entender a ideia, o problema que ela resolve e quem vai usar.',
    }
  : isCloud
    ? {
        title: 'Falar sobre o projeto',
        description: 'Conte como está sua infraestrutura hoje. A primeira conversa com a Aurion Cloud é sobre o seu projeto.',
        eyebrow: 'Aurion Cloud',
        heroTitle: 'Conte como está sua infraestrutura hoje',
        heroIntro: 'Não precisa ter o diagnóstico pronto. Queremos entender o ambiente atual, os riscos e o que você precisa resolver.',
      }
    : {
        title: 'Agendar diagnóstico',
        description: 'Conte como a sua operação funciona hoje. A primeira conversa com a Aurion é um diagnóstico.',
        eyebrow: 'Agendar diagnóstico',
        heroTitle: 'Comece contando como funciona hoje',
        heroIntro: 'Não precisa ter a solução pronta. Quanto mais detalhes você der, mais útil será a primeira conversa.',
      };
---

<Layout title={heroPorOrigem.title} description={heroPorOrigem.description}>
  <PageHero
    eyebrow={heroPorOrigem.eyebrow}
    title={heroPorOrigem.heroTitle}
    intro={heroPorOrigem.heroIntro}
  />

  <section>
    <div class="container-site grid gap-12 py-24 lg:grid-cols-[2fr_1fr]">
      <div
        id="form-sucesso"
        hidden
        tabindex="-1"
        class="card h-fit border-gold/50 p-8 outline-none"
      >
        <p class="eyebrow">Recebido</p>
        <h2 class="mt-4 text-2xl font-light tracking-tight">Obrigado. Vamos ler com atenção.</h2>
        <p class="mt-4 text-sm leading-relaxed text-muted">
          Entraremos em contato pelo e-mail informado para marcar a conversa de diagnóstico.
        </p>
        <a href="/" class="btn-secondary mt-8 w-fit">Voltar ao início</a>
      </div>

      <form id="form-diagnostico" action="/api/contact" method="POST" class="grid gap-6">
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label>
            Não preencha este campo
            <input type="text" name="_hp" tabindex="-1" autocomplete="off" />
          </label>
        </div>
        <input type="hidden" name="origem" value="" id="campo-origem" />

        <div class="grid gap-6 sm:grid-cols-2">
          <label class={labelClass}>
            Nome
            <input name="nome" required autocomplete="name" class={inputClass} />
          </label>
          <label class={labelClass}>
            Empresa
            <input name="empresa" autocomplete="organization" class={inputClass} />
          </label>
          <label class={labelClass}>
            E-mail
            <input name="email" type="email" required autocomplete="email" class={inputClass} />
          </label>
          <label class={labelClass}>
            Telefone / WhatsApp
            <input name="telefone" type="tel" autocomplete="tel" class={inputClass} />
          </label>
          <label id="label-segmento" class:list={[labelClass, 'sm:col-span-2']}>
            Ramo de atuação
            <input
              id="input-segmento"
              name="segmento"
              placeholder="Indústria, distribuição, contabilidade..."
              class={inputClass}
            />
          </label>
          <label id="label-contexto" class:list={[labelClass, 'sm:col-span-2']}>
            O que você quer resolver?
            <textarea
              id="textarea-contexto"
              name="contexto"
              rows="4"
              placeholder="Descreva o problema ou o que está te travando — pode ser informal."
              class={inputClass}></textarea>
          </label>
        </div>

        <label class="flex items-start gap-3 text-sm text-muted">
          <input type="checkbox" name="consentimento" required class="mt-1 size-4 accent-gold" />
          <span>
            Concordo com o uso destes dados para que a Aurion entre em contato sobre <span id="texto-consentimento">o diagnóstico</span>, conforme a
            <a href="/privacidade" class="font-medium text-gold underline">política de privacidade</a>.
          </span>
        </label>

        <div class="flex flex-wrap items-center gap-4">
          <button id="btn-submit" type="submit" class="btn-primary w-fit disabled:cursor-not-allowed disabled:opacity-50">
            Enviar para diagnóstico
          </button>
          <p id="form-status" role="status" aria-live="polite" class="text-sm text-muted"></p>
        </div>
      </form>

      <aside class="card h-fit p-8">
        <h2 class="eyebrow">O que acontece depois</h2>
        <ol id="lista-depois" class="mt-4 grid gap-3 text-sm text-muted">
          <li>1. Lemos com atenção o que você descreveu.</li>
          <li>2. Marcamos uma conversa para entender cada etapa em detalhe.</li>
          <li>3. Você recebe uma visão clara do problema e dos próximos passos.</li>
        </ol>

        <h2 class="eyebrow mt-10">Prefere outro canal?</h2>
        <div class="mt-3 grid gap-2 text-sm">
          <a href={`mailto:${site.email}`} class="text-gold hover:underline">{site.email}</a>
          <a href={`https://wa.me/${site.whatsapp}`} class="text-gold hover:underline">WhatsApp</a>
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="text-gold hover:underline">LinkedIn</a>
          <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="text-gold hover:underline">Instagram</a>
        </div>
      </aside>
    </div>
  </section>

  <script>
    const params = new URLSearchParams(window.location.search);
    const origem = params.get('origem');
    const isLab = origem === 'aurion-lab';
    const isCloud = origem === 'aurion-cloud';

    const textosPorOrigem = {
      'aurion-lab': {
        eyebrow: 'Aurion Lab',
        titulo: 'Conte como você imagina o produto',
        intro: 'Não precisa estar tudo definido. Queremos entender a ideia, o problema que ela resolve e quem vai usar.',
        labelSegmento: 'Tipo de projeto',
        placeholderSegmento: 'App mobile, sistema web, protótipo, produto SaaS...',
        labelContexto: 'Qual é a ideia?',
        placeholderContexto: 'Descreva a ideia, o problema que quer resolver e quem vai usar o app — pode ser informal.',
        consentimento: 'o projeto',
        botao: 'Enviar proposta',
        depois: [
          'Lemos com atenção o que você descreveu sobre o projeto.',
          'Marcamos uma conversa para entender a ideia, os usuários e o que precisa ser construído.',
          'Você recebe uma direção clara sobre escopo, tecnologia e próximos passos.',
        ],
      },
      'aurion-cloud': {
        eyebrow: 'Aurion Cloud',
        titulo: 'Conte como está sua infraestrutura hoje',
        intro: 'Não precisa ter o diagnóstico pronto. Queremos entender o ambiente atual, os riscos e o que você precisa resolver.',
        labelSegmento: 'Tipo de ambiente',
        placeholderSegmento: 'Servidores próprios, nuvem, híbrido, sem infraestrutura ainda...',
        labelContexto: 'O que você precisa resolver?',
        placeholderContexto: 'Descreva o ambiente atual, hospedagem, segurança ou o que está travando — pode ser informal.',
        consentimento: 'o projeto',
        botao: 'Enviar proposta',
        depois: [
          'Lemos com atenção o que você descreveu sobre o ambiente e a infraestrutura.',
          'Marcamos uma conversa para entender riscos, hospedagem e segurança em detalhe.',
          'Você recebe uma direção clara sobre infraestrutura, custos e próximos passos.',
        ],
      },
    } as const;

    if (isLab || isCloud) {
      const textos = textosPorOrigem[origem as 'aurion-lab' | 'aurion-cloud'];

      // Hero — seletores diretos do PageHero
      const heroSection = document.querySelector('section.relative.overflow-hidden');
      if (heroSection) {
        const eyebrowEl = heroSection.querySelector('p.eyebrow');
        const titleEl = heroSection.querySelector('h1');
        const introEl = heroSection.querySelector('p.text-muted');
        if (eyebrowEl) eyebrowEl.textContent = textos.eyebrow;
        if (titleEl) titleEl.textContent = textos.titulo;
        if (introEl) introEl.textContent = textos.intro;
      }

      // Campo origem
      const campoOrigem = document.querySelector<HTMLInputElement>('#campo-origem');
      if (campoOrigem) campoOrigem.value = origem ?? '';

      // Segmento
      const labelSegmento = document.querySelector<HTMLLabelElement>('#label-segmento');
      const inputSegmento = document.querySelector<HTMLInputElement>('#input-segmento');
      if (labelSegmento) {
        labelSegmento.childNodes.forEach((n) => { if (n.nodeType === Node.TEXT_NODE) n.textContent = textos.labelSegmento; });
      }
      if (inputSegmento) inputSegmento.placeholder = textos.placeholderSegmento;

      // Contexto
      const labelContexto = document.querySelector<HTMLLabelElement>('#label-contexto');
      const textareaContexto = document.querySelector<HTMLTextAreaElement>('#textarea-contexto');
      if (labelContexto) {
        labelContexto.childNodes.forEach((n) => { if (n.nodeType === Node.TEXT_NODE) n.textContent = textos.labelContexto; });
      }
      if (textareaContexto) textareaContexto.placeholder = textos.placeholderContexto;

      // Consentimento
      const textoConsentimento = document.querySelector('#texto-consentimento');
      if (textoConsentimento) textoConsentimento.textContent = textos.consentimento;

      // Botão
      const btn = document.querySelector<HTMLButtonElement>('#btn-submit');
      if (btn) btn.textContent = textos.botao;

      // O que acontece depois
      const lista = document.querySelector('#lista-depois');
      if (lista) {
        lista.innerHTML = textos.depois.map((item, i) => `<li>${i + 1}. ${item}</li>`).join('\n');
      }
    }

    // Formulário
    const form = document.querySelector<HTMLFormElement>('#form-diagnostico');
    const status = document.querySelector<HTMLElement>('#form-status');
    const sucesso = document.querySelector<HTMLElement>('#form-sucesso');

    const mostrarErro = (mensagem: string) => {
      if (!status) return;
      status.className = 'text-sm text-red-400';
      status.textContent = mensagem;
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status || !sucesso) return;

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const data = new FormData(form);
      const texto = (name: string) => String(data.get(name) ?? '');

      button?.setAttribute('disabled', '');
      status.className = 'text-sm text-muted';
      status.textContent = 'Enviando…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            nome: texto('nome'),
            empresa: texto('empresa'),
            email: texto('email'),
            telefone: texto('telefone'),
            segmento: texto('segmento'),
            contexto: texto('contexto'),
            lgpd: data.get('consentimento') === 'on',
            origem: texto('origem'),
            _hp: texto('_hp'),
          }),
        });
        const result = (await response.json().catch(() => null)) as { ok?: boolean; error?: string } | null;

        if (!response.ok || !result?.ok) {
          mostrarErro(result?.error ?? 'Não foi possível enviar agora. Tente de novo em instantes.');
          button?.removeAttribute('disabled');
          return;
        }

        form.hidden = true;
        sucesso.hidden = false;
        sucesso.focus();
        sucesso.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        mostrarErro('Sem conexão com o servidor. Verifique a internet e tente de novo.');
        button?.removeAttribute('disabled');
      }
    });
  </script>
</Layout>
