---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';

const inputClass =
  'mt-2 w-full rounded-md border border-line bg-surface px-4 py-3 text-sm text-fg outline-none transition placeholder:text-muted/60 focus:border-gold focus:ring-2 focus:ring-gold/20';
const labelClass = 'block text-sm font-medium text-sand';
---

<Layout
  title="Agendar diagnóstico"
  description="Conte como a sua operação funciona hoje. A primeira conversa com a Aurion é um diagnóstico."
>
  <PageHero
    eyebrow="Agendar diagnóstico"
    title="Comece contando como funciona hoje"
    intro="Não precisa ter a solução pronta. Quanto mais detalhes você der, mais útil será a primeira conversa."
  />

  <section>
    <div class="container-site grid gap-12 py-24 lg:grid-cols-[2fr_1fr]">
      <div
        id="form-sucesso"
        hidden
        tabindex="-1"
        class="card h-fit border-gold/50 p-8 outline-none"
      >
        <p class="eyebrow">Recebido</p>
        <h2 class="mt-4 text-2xl font-light tracking-tight">Obrigado. Vamos ler com atenção.</h2>
        <p class="mt-4 text-sm leading-relaxed text-muted">
          Entraremos em contato pelo e-mail informado para marcar a conversa de diagnóstico.
        </p>
        <a href="/" class="btn-secondary mt-8 w-fit">Voltar ao início</a>
      </div>

      <form id="form-diagnostico" action="/api/contact" method="POST" class="grid gap-6">
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label>
            Não preencha este campo
            <input type="text" name="_hp" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <fieldset class="grid gap-6 sm:grid-cols-2">
          <legend class="eyebrow mb-6">Sobre você</legend>
          <label class={labelClass}>
            Nome
            <input name="nome" required autocomplete="name" class={inputClass} />
          </label>
          <label class={labelClass}>
            Empresa
            <input name="empresa" required autocomplete="organization" class={inputClass} />
          </label>
          <label class={labelClass}>
            E-mail
            <input name="email" type="email" required autocomplete="email" class={inputClass} />
          </label>
          <label class={labelClass}>
            Telefone / WhatsApp
            <input name="telefone" type="tel" autocomplete="tel" class={inputClass} />
          </label>
          <label class:list={[labelClass, 'sm:col-span-2']}>
            Ramo de atuação
            <input name="segmento" placeholder="Indústria, distribuição, contabilidade..." class={inputClass} />
          </label>
        </fieldset>

        <fieldset class="grid gap-6">
          <legend class="eyebrow mb-6">Sobre a operação</legend>
          <label class={labelClass}>
            Como o processo funciona hoje?
            <textarea
              name="processo_atual"
              rows="4"
              required
              placeholder="Descreva o passo a passo, mesmo que seja informal."
              class={inputClass}></textarea>
          </label>
          <label class={labelClass}>
            Quem é o responsável hoje?
            <input name="responsavel" placeholder="Cargo ou área" class={inputClass} />
          </label>
          <label class={labelClass}>
            Onde está a maior dor?
            <textarea
              name="dor"
              rows="3"
              placeholder="Tempo perdido, erros, retrabalho, falta de informação..."
              class={inputClass}></textarea>
          </label>
          <label class={labelClass}>
            Quais sistemas ou ferramentas vocês usam hoje?
            <input name="sistemas" placeholder="ERP, planilhas, WhatsApp..." class={inputClass} />
          </label>
        </fieldset>

        <label class="flex items-start gap-3 text-sm text-muted">
          <input type="checkbox" name="consentimento" required class="mt-1 size-4 accent-gold" />
          <span>
            Concordo com o uso destes dados para que a Aurion entre em contato sobre o diagnóstico, conforme a
            <a href="/privacidade" class="font-medium text-gold underline">política de privacidade</a>.
          </span>
        </label>

        <div class="flex flex-wrap items-center gap-4">
          <button type="submit" class="btn-primary w-fit disabled:cursor-not-allowed disabled:opacity-50">
            Enviar para diagnóstico
          </button>
          <p id="form-status" role="status" aria-live="polite" class="text-sm text-muted"></p>
        </div>
      </form>

      <aside class="card h-fit p-8">
        <h2 class="eyebrow">O que acontece depois</h2>
        <ol class="mt-4 grid gap-3 text-sm text-muted">
          <li>1. Lemos com atenção o que você descreveu.</li>
          <li>2. Marcamos uma conversa para entender cada etapa em detalhe.</li>
          <li>3. Você recebe uma visão clara do problema e dos próximos passos.</li>
        </ol>

        <h2 class="eyebrow mt-10">Prefere outro canal?</h2>
        <div class="mt-3 grid gap-2 text-sm">
          {site.email ? <a href={`mailto:${site.email}`} class="text-gold hover:underline">{site.email}</a> : <span class="rascunho w-fit">e-mail a definir</span>}
          {site.whatsapp ? <a href={`https://wa.me/${site.whatsapp}`} class="text-gold hover:underline">WhatsApp</a> : <span class="rascunho w-fit">WhatsApp a definir</span>}
        </div>
      </aside>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('#form-diagnostico');
    const status = document.querySelector<HTMLElement>('#form-status');
    const sucesso = document.querySelector<HTMLElement>('#form-sucesso');

    const mostrarErro = (mensagem: string) => {
      if (!status) return;
      status.className = 'text-sm text-red-400';
      status.textContent = mensagem;
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status || !sucesso) return;

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const data = new FormData(form);
      const texto = (name: string) => String(data.get(name) ?? '');

      button?.setAttribute('disabled', '');
      status.className = 'text-sm text-muted';
      status.textContent = 'Enviando…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            nome: texto('nome'),
            empresa: texto('empresa'),
            email: texto('email'),
            telefone: texto('telefone'),
            segmento: texto('segmento'),
            processo: texto('processo_atual'),
            responsavel: texto('responsavel'),
            dor: texto('dor'),
            sistemas: texto('sistemas'),
            lgpd: data.get('consentimento') === 'on',
            _hp: texto('_hp'),
          }),
        });
        const result = (await response.json().catch(() => null)) as { ok?: boolean; error?: string } | null;

        if (!response.ok || !result?.ok) {
          mostrarErro(result?.error ?? 'Não foi possível enviar agora. Tente de novo em instantes.');
          button?.removeAttribute('disabled');
          return;
        }

        form.hidden = true;
        sucesso.hidden = false;
        sucesso.focus();
        sucesso.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        mostrarErro('Sem conexão com o servidor. Verifique a internet e tente de novo.');
        button?.removeAttribute('disabled');
      }
    });
  </script>
</Layout>
