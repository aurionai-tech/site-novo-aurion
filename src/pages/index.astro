---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MethodSteps from '../components/MethodSteps.astro';
import CtaDiagnostico from '../components/CtaDiagnostico.astro';
import barrasOuro from '../assets/brand/barras-ouro.png';
import { principio, servicos, ecossistema, site, submarcas } from '../data/site';
---

<Layout>
  <section class="relative overflow-hidden border-b border-line">
    <Image
      src={barrasOuro}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover object-[70%_50%] opacity-70 md:object-[center_50%]"
    />
    <div class="absolute inset-0 bg-linear-to-r from-bg via-bg/85 to-bg/10"></div>
    <div class="absolute inset-x-0 bottom-0 h-32 bg-linear-to-t from-bg to-transparent"></div>

    <div class="relative container-site py-24 md:py-36">
      <p class="eyebrow">{site.assinatura}</p>
      <h1 class="mt-6 max-w-3xl text-5xl leading-[1.05] font-light tracking-tight md:text-7xl">
        Primeiro o processo.<br /><span class="font-semibold text-gold">Depois a tecnologia.</span>
      </h1>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-muted">
        A Aurion mapeia como a sua operação funciona de verdade e só então constrói software, dados e automação em cima
        dela. Sem atalho, sem retrabalho.
      </p>
      <div class="mt-12 flex flex-wrap gap-4">
        <a href="/contato" class="btn-primary">Agendar diagnóstico</a>
        <a href="/como-trabalhamos" class="btn-secondary">Como trabalhamos</a>
      </div>
    </div>
  </section>

  <section>
    <div class="container-site grid gap-10 py-24 md:grid-cols-[1.2fr_1fr] md:items-center">
      <blockquote class="border-l-2 border-gold pl-8 text-3xl leading-tight font-light tracking-tight md:text-4xl">
        “{principio.frase}”
      </blockquote>
      <p class="text-lg leading-relaxed text-muted">{principio.explicacao}</p>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="container-site py-24">
      <SectionHeading
        eyebrow="Como trabalhamos"
        title="Do diagnóstico à automação, nessa ordem"
        intro="Cada etapa tem entrega clara. A tecnologia entra quando o processo está pronto para recebê-la."
      />
      <div class="mt-14">
        <MethodSteps />
      </div>
      <a href="/como-trabalhamos" class="mt-10 inline-block text-xs font-semibold tracking-[0.15em] text-gold uppercase hover:text-gold-light">
        Conheça o método em detalhe →
      </a>
    </div>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="container-site py-24">
      <SectionHeading eyebrow="Serviços" title="O que entregamos" />
      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          servicos.map((s) => (
            <article class="card bg-bg hover:border-gold/50">
              <h3 class="text-lg font-semibold">{s.titulo}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{s.descricao}</p>
            </article>
          ))
        }
      </div>
      <a href="/servicos" class="mt-10 inline-block text-xs font-semibold tracking-[0.15em] text-gold uppercase hover:text-gold-light">
        Ver todos os serviços →
      </a>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="container-site py-24">
      <SectionHeading eyebrow="Frentes Aurion" title="Uma marca, frentes especializadas" />
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {
          submarcas.map((m) => (
            <article class="card flex flex-col items-center text-center">
              <img src={m.logo} alt={m.nome} width="192" height="99" class="h-auto w-44" loading="lazy" />
              {m.emBreve ? (
                <p class="mt-6 text-xs tracking-[0.2em] text-muted uppercase">Em breve</p>
              ) : (
                <p class="mt-6 text-sm leading-relaxed text-muted">{m.descricao}</p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="container-site py-16">
      <p class="eyebrow text-center">Ecossistema</p>
      <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-16 gap-y-4">
        {ecossistema.map((e) => <li class="text-lg font-light tracking-wide text-sand" title={e.detalhe}>{e.nome}</li>)}
      </ul>
    </div>
  </section>

  <CtaDiagnostico />
</Layout>
