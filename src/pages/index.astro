---
import Layout from '../layouts/Layout.astro';
import HeroCaos from '../components/home/HeroCaos.astro';
import Manifesto from '../components/home/Manifesto.astro';
import MetodoHorizontal from '../components/home/MetodoHorizontal.astro';
import ServicosLista from '../components/home/ServicosLista.astro';
import FrentesHome from '../components/home/FrentesHome.astro';
import Encerramento from '../components/home/Encerramento.astro';
---

<Layout>
  <div class="grain" aria-hidden="true"></div>
  <HeroCaos />
  <Manifesto />
  <MetodoHorizontal />
  <ServicosLista />
  <FrentesHome />
  <Encerramento />
</Layout>

<script>
  import { gsap, ScrollTrigger, reduceMotion, startSmoothScroll } from '../scripts/motion';
  import { initFio } from '../scripts/fio';

  startSmoothScroll();
  initFio();

  if (!reduceMotion) {
    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
      gsap.from(el, {
        y: 48,
        opacity: 0,
        duration: 1.2,
        delay: parseFloat(el.style.getPropertyValue('--d')) / 1000 || 0,
        ease: 'power3.out',
        clearProps: 'transform,opacity',
        scrollTrigger: { trigger: el, start: 'top 88%' },
      });
    });
  }

  document.fonts?.ready.then(() => ScrollTrigger.refresh());
  window.addEventListener('load', () => ScrollTrigger.refresh());
</script>
