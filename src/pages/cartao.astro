---
import { site } from '../data/site';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Aurion | Contato</title>
    <meta name="description" content="Organizando e simplificando o trabalho que já acontece." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --bg: #0a0a0a;
        --surface: #141414;
        --line: #2c2c2c;
        --fg: #ffffff;
        --muted: #9a9a9a;
        --gold: #c6b272;
        --safe-bottom: env(safe-area-inset-bottom, 0px);
      }

      html,
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: Montserrat, system-ui, sans-serif;
        min-height: 100dvh;
      }

      body {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1.25rem calc(2.5rem + var(--safe-bottom));
        gap: 2rem;
      }

      .brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.65rem;
        text-decoration: none;
        color: inherit;
        text-align: center;
      }

      .brand img {
        height: 2.75rem;
        width: auto;
      }

      .assinatura {
        font-size: 0.65rem;
        font-weight: 500;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--gold);
      }

      /* Frase para refrescar a memória — curta, dinâmica, com leve destaque. */
      .frase {
        max-width: 18rem;
        text-align: center;
        font-size: clamp(1.25rem, 5vw, 1.55rem);
        font-weight: 300;
        line-height: 1.35;
        letter-spacing: -0.01em;
        color: var(--fg);
      }

      .frase strong {
        font-weight: 600;
        color: var(--gold);
      }

      .links {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        width: 100%;
        max-width: 22rem;
      }

      .link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        min-height: 2.75rem;
        padding: 0.7rem 1rem;
        border: 1px solid var(--line);
        border-radius: 0.65rem;
        background: var(--surface);
        color: var(--fg);
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-decoration: none;
        text-transform: uppercase;
        transition:
          background 0.15s,
          border-color 0.15s,
          color 0.15s;
      }

      .link:hover {
        border-color: rgb(198 178 114 / 0.45);
        color: var(--gold);
      }

      .link-primary {
        background: var(--gold);
        border-color: var(--gold);
        color: var(--bg);
      }

      .link-primary:hover {
        background: #dccb93;
        border-color: #dccb93;
        color: var(--bg);
      }

      .link svg {
        flex-shrink: 0;
        opacity: 0.85;
      }

      .footer {
        font-size: 0.7rem;
        color: var(--muted);
        text-align: center;
      }
    </style>
  </head>
  <body>
    <a href="https://aurionai.com.br" class="brand" target="_blank" rel="noopener noreferrer">
      <img src="/brand/logo-dourado-branco-recortado.svg" alt="Aurion" />
      <span class="assinatura">{site.assinatura}</span>
    </a>

    <p class="frase">
      Organizando e simplificando
      <strong> o trabalho que já acontece.</strong>
    </p>

    <div class="links">
      {
        site.whatsapp && (
          <a href={`https://wa.me/${site.whatsapp}`} class="link link-primary" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
            WhatsApp
          </a>
        )
      }
      {
        site.email && (
          <a href={`mailto:${site.email}`} class="link">
            E-mail
          </a>
        )
      }
      {
        site.linkedin && (
          <a href={site.linkedin} class="link" target="_blank" rel="noopener noreferrer">
            LinkedIn
          </a>
        )
      }
      {
        site.instagram && (
          <a href={site.instagram} class="link" target="_blank" rel="noopener noreferrer">
            Instagram
          </a>
        )
      }
      <a href="/contato" class="link">Agendar diagnóstico</a>
    </div>

    <p class="footer">© {new Date().getFullYear()} Aurion Software LTDA</p>
  </body>
</html>
